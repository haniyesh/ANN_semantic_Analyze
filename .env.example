# ── Telegram (Telethon user session — for the live listener) ─────────────────
# Get API_ID and API_HASH from https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_SESSION=telegram_session          # filename (no .session extension)
TELEGRAM_BOT_TOKEN=123456789:AABBcc...     # from @BotFather
ADMIN_ID=123456789                         # your Telegram user ID
TELEGRAM_CHANNEL_ID=@your_channel          # channel to post hot signals to
TELEGRAM_CHANNELS=the_block_crypto,coindesk,cointelegraph,WatcherGuru

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# In Docker: postgresql://cryptouser:PASSWORD@postgres:5432/cryptonews
DATABASE_URL=postgresql://user:password@localhost:5432/cryptonews

# Required by docker-compose postgres service
POSTGRES_DB=cryptonews
POSTGRES_USER=cryptouser
POSTGRES_PASSWORD=change_me_strong_password

# ── API Security ──────────────────────────────────────────────────────────────
# Secret key for POST /news endpoint (bot → API)
INGEST_API_KEY=change_me_random_32_chars
# Separate secret for POST /analyze/custom. Never put this in VITE_* variables.
ANALYZE_API_KEY=change_me_different_random_32_chars

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Set to "true" if running behind a reverse proxy (nginx, Caddy, etc.)
# Enables X-Forwarded-For for real client IP rate limiting
BEHIND_PROXY=false

# ── AI / LLM APIs ─────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
GROQ_API_KEY_2=gsk_...                     # optional second key for rotation
GROQ_CLASSIFICATION_MODEL=llama-3.1-8b-instant
GROQ_RERANK_MODEL=llama-3.1-8b-instant

HF_API_KEY=hf_...                          # HuggingFace (optional, for private models)
HF_INFERENCE_URL=                          # optional HF inference endpoint
# Production Hugging Face revisions are immutable constants in services/model_refs.py.

GEMINI_API=                                # optional
DEEPSEEK_API=                              # optional
OPENAI_API_KEY=                            # optional

# ── Vector DB (Qdrant Cloud) — required for RAG features ─────────────────────
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# ── Misc ──────────────────────────────────────────────────────────────────────
NEWS_API_KEY=                              # optional NewsAPI.org key
KAGGLE_TOKEN_API=                          # optional, for dataset downloads
SOCIAVAULT=                                # optional
EMBEDDING_MODEL=                           # optional custom embedding model
VECTOR_DIM=768                             # embedding dimension

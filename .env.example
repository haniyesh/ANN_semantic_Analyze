# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram (Telethon user session — for the live listener) ─────────────────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=            # Telethon string session
TELEGRAM_BOT_TOKEN=          # bot token (for alerts)
TELEGRAM_CHANNELS=cointelegraph,coindesk,WatcherGuru,the_block_crypto,whale_alert_io
SIGNAL_CHANNEL_ID=           # chat id the bot posts HOT signals to
ADMIN_ID=

# ── Database (Postgres) ──────────────────────────────────────────────────────
# If unset, main.py runs in cache-only mode (news_cache.json).
DB_URL=postgresql://user:pass@host:5432/dbname
DB_SSL_CA=                   # path to CA bundle for TLS verification (prod)
# DB_SSL_INSECURE=1          # only for local dev with self-signed certs

# ── Vector DB (Qdrant Cloud) — required for RAG features ─────────────────────
QDRANT_URL=
QDRANT_API_KEY=

# ── LLM / NLP ────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_CLASSIFICATION_MODEL=llama-3.1-8b-instant
HF_API_KEY=
SENTIMENT_MODEL_NAME=ProsusAI/finbert
MODEL_PATH=production_system_v8.pt

# ── API server ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_API=http://localhost:8000

# CORS: comma-separated allowed origins. Do NOT use "*".
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Shared secret required to POST /news (the live pipeline write endpoint).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_API_KEY=

# ── External APIs ────────────────────────────────────────────────────────────
BINANCE_API=https://api.binance.com/api/v3
COINGECKO_API=https://api.coingecko.com/api/v3
